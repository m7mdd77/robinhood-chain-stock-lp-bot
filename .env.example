# Wallet
PRIVATE_KEY=0xYOUR_PRIVATE_KEY
WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS

# Robinhood Chain
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Leave blank to prompt every startup. For unattended startup, use the catalog
# key, full pool ID, or exact label printed by the startup menu.
POOL_CHOICE=
# Leave blank to prompt every startup. Example: 3 means -3% / +3%.
RANGE_PERCENT=

# Show live 24h-annualized Uniswap fee APR beside every pool at startup.
SHOW_POOL_APR=true
POOL_APR_TIMEOUT_SECONDS=12

# The official Robinhood asset registry and compatible Uniswap pool catalog are
# refreshed automatically and cached locally. A failed refresh uses the cache.
ROBINHOOD_POOL_CATALOG_REFRESH_HOURS=6
ROBINHOOD_POOL_CATALOG_TIMEOUT_SECONDS=20
# Ignore permissionless dust pools and extreme-fee pools during discovery.
ROBINHOOD_POOL_MIN_TVL_USD=100
ROBINHOOD_POOL_MAX_FEE=50000

# Swap safety
SLIPPAGE_PERCENT=0.01
MAX_PRICE_IMPACT_PERCENT=0.05
LP_MINT_TOLERANCE_PERCENT=0.20
MIN_SWAP_VALUE_QUOTE=1
# ETH-equivalent balancing threshold for stock/ETH pools. This is separate
# from MIN_SWAP_VALUE_QUOTE because one stock token is not approximately $1.
MIN_SWAP_VALUE_ETH=0.0005
SWAP_RETRY_SECONDS=15
SWAP_ROUTE_PROVIDERS=uniswap,kyberswap

# KyberSwap Robinhood provisional API
KYBER_ROUTES_URL=https://aggregator-api.kyberswap.com/robinhood/api/v1/routes
KYBER_BUILD_URL=https://aggregator-api.kyberswap.com/robinhood/api/v1/route/build
KYBER_CLIENT_ID=robinhood-multi-pool-v4-bot

# Keep at least this much native ETH untouched for gas for every pool. For
# stock/USDG pools, only ETH above this reserve can be converted to USDG.
# For stock/ETH pools, this reserve is excluded from the ETH deposit maximum.
NATIVE_GAS_RESERVE_ETH=0.01
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# Telegram 4-hour status reports (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STATUS_REPORT_HOURS=4

# Claim LP fees without removing liquidity. Keep the paired-token fees and
# convert only the claimed stock-token fees to native ETH through KyberSwap.
FEE_CLAIM_HOURS=4
SELL_STOCK_FEES_TO_ETH=true
MIN_STOCK_FEE_SELL_USD=1

# Ctrl+C withdraws the active V4 position before stopping.
WITHDRAW_ON_CTRL_C=true

# Transaction settings
TX_DEADLINE_SECONDS=180
HTTP_TIMEOUT_SECONDS=25
GAS_LIMIT_MULTIPLIER=1.20
PRIORITY_FEE_GWEI=0.02
MAX_FEE_BASE_MULTIPLIER=2
